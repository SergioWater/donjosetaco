---
import type { MediaItem } from '../lib/media';
interface Props {items:MediaItem[];emptyHint?:string;}
const {items,emptyHint='More photos coming soon.'}=Astro.props;
---
<div class="media-block">{items.length===0?<p>{emptyHint}</p>:<ul class="media-grid">{items.map(item=><li><a href={item.src} data-lightbox><img src={item.src} alt={item.alt} loading="lazy" decoding="async"/><span>View full image ↗</span></a></li>)}</ul>}{items.length>0 && <dialog class="lightbox" aria-label="Image preview"><form method="dialog"><button type="submit" aria-label="Close image preview">Close ×</button></form><img alt=""/></dialog>}</div>
<style>
.media-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1.5rem}.media-grid a{display:block;border:1px solid var(--line);background:var(--card);border-radius:8px;overflow:hidden;text-decoration:none}.media-grid img{width:100%;height:340px;object-fit:contain;background:var(--bg)}.media-grid span{display:block;padding:.8rem 1rem;font-size:.8rem;font-weight:600}.lightbox{border:0;padding:1rem;border-radius:8px;background:var(--paper);width:min(92vw,1100px);max-height:92vh}.lightbox::backdrop{background:#102b20eb}.lightbox img{max-height:78vh;width:100%;object-fit:contain}.lightbox form{display:flex;justify-content:flex-end;margin-bottom:.7rem}.lightbox button{background:var(--bg);border:0;color:var(--paper);border-radius:5px;padding:.7rem 1rem;font:inherit;cursor:pointer}
</style>
<script>
document.querySelectorAll<HTMLDialogElement>('.lightbox').forEach(dialog=>{const preview=dialog.querySelector('img');if(!preview)return;dialog.closest('.media-block')?.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach(link=>{link.addEventListener('click',event=>{event.preventDefault();preview.src=link.href;preview.alt=link.querySelector('img')?.alt??'';dialog.showModal();});});dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});});
</script>
