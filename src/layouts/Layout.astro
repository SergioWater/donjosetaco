---
import { SITE_NAME } from '../data/categories';
import { MENU_SECTIONS, STREET_ADDRESS, BUSINESS_HOURS, PHONE, PHONE_LABEL } from '../data/menu';
interface Props { title?: string; description?: string; }
const { title='Shrimp Tacos in San Jose', description='Don Jose Tacos in San Jose: tacos de camarón, shrimp tacos, burritos, quesadillas, mulitas, and drinks. Call (669) 301-6355 to order for pickup.' } = Astro.props;
const pageTitle = title === SITE_NAME ? title : title + ' | ' + SITE_NAME;
const current = Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(current === '/' ? '/' : current.replace(/\/$/, '') + '/', Astro.site).href : undefined;
const business = {"@context":"https://schema.org","@type":"Restaurant",name:SITE_NAME,telephone:PHONE,servesCuisine:"Mexican",address:{"@type":"PostalAddress",streetAddress:STREET_ADDRESS,addressLocality:"San Jose",addressRegion:"CA",addressCountry:"US"},openingHoursSpecification:BUSINESS_HOURS.map(hours=>({"@type":"OpeningHoursSpecification",dayOfWeek:hours.days.map(day=>"https://schema.org/"+day),opens:hours.opens,closes:hours.closes}))};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}<meta name="description" content={description} />
<meta name="theme-color" content="#153b2a" />
<meta property="og:type" content="website" /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<script type="application/ld+json" set:html={JSON.stringify(business)} />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="top-strip"><span>SAN JOSE, CALIFORNIA</span><a href={'tel:' + PHONE}>HUNGRY? CALL {PHONE_LABEL}</a></div>
<header class="site-header">
<a class="brand nav-brand" href="/" aria-label="Don Jose Tacos home"><img class="brand-logo" src="/images/don-jose-logo-ai.webp" alt="Don Jose Tacos smiling mascot logo" width="144" height="96" fetchpriority="high" /></a>
<nav aria-label="Primary navigation">
<a href="/" aria-current={current==='/'?'page':undefined}>Home</a>
<details class="menu-dropdown"><summary class:list={{active:current==='/menu'}}>Menu <span aria-hidden="true">⌄</span></summary><div class="dropdown-panel"><a href="/menu">Full menu</a><a href="/menu#fillings">Meats & fillings</a>{MENU_SECTIONS.map(section=><a href={'/menu#'+section.id}>{section.title}</a>)}</div></details>
<a href="/locations" aria-current={current==='/locations'?'page':undefined}>Locations</a>
<a href="/gallery" aria-current={current.startsWith('/gallery')?'page':undefined}>Photos</a>
<a class="button nav-order" href="/order" aria-current={current==='/order'?'page':undefined}>Order by phone <span aria-hidden="true">↗</span></a>
</nav>
</header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="footer-inner"><div><a class="brand" href="/"><span>DON JOSÉ</span><small>TACOS · SAN JOSE</small></a><p>Tacos de camarón. Your next favorite bite.</p></div><div><p class="eyebrow">COME HUNGRY</p><a href="/menu">Explore the menu</a><a href="/locations">Find the truck</a><a href="/locations">{STREET_ADDRESS}<br/>San Jose, CA</a></div><div><p class="eyebrow">CALL TO ORDER</p><a class="footer-phone" href={'tel:'+PHONE}>{PHONE_LABEL}</a><p>Call for prices & pickup availability.</p></div></div><div class="footer-bottom">© {new Date().getFullYear()} Don Jose Tacos<span>Made for good food & good company.</span></div></footer>
<a class="mobile-call" href={'tel:'+PHONE}>Call to order <strong>{PHONE_LABEL}</strong></a>
</body>
</html>
<style is:global>
:root{--bg:#153b2a;--paper:#fff6e5;--ink:#183326;--chile:#ad3425;--orange:#ed6d36;--gold:#ffd35a;--muted:#606454;--card:#fffbf2;--line:#d7d7bf;--shadow:0 12px 35px #18332612}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:125px}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.6}a{color:inherit}img{display:block;max-width:100%}button,summary,a{-webkit-tap-highlight-color:transparent}a:focus-visible,summary:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:5px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Arial,Helvetica,sans-serif;font-weight:700;line-height:1.15}h1{font-size:clamp(2.7rem,6.5vw,5.6rem);letter-spacing:-.025em;margin-bottom:1.4rem}h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.02em}h3{font-size:1.4rem}p{margin-bottom:1rem}.skip-link{position:absolute;left:1rem;top:-100px;z-index:100;background:var(--gold);padding:1rem}.skip-link:focus{top:1rem}.top-strip{background:var(--chile);color:var(--paper);display:flex;justify-content:space-between;padding:.5rem max(5vw,1rem);font-size:.7rem;font-weight:700;letter-spacing:.13em}.top-strip a{text-decoration:none}.site-header{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:1px solid var(--line);padding:1.1rem max(5vw,1rem);display:flex;align-items:center;justify-content:space-between;gap:1rem}.brand{text-decoration:none;display:inline-flex;flex-direction:column;line-height:1.1;flex-shrink:0}.nav-brand{display:block}.brand-logo{width:144px;height:96px;object-fit:contain}.brand span{font-family:Arial,Helvetica,sans-serif;font-weight:900;font-size:1.9rem;letter-spacing:-.06em}.brand small{font-size:.63rem;letter-spacing:.24em;margin-top:.4rem;font-weight:700}.site-header nav{display:flex;align-items:center;gap:1.9rem;font-size:.88rem;font-weight:600}.site-header nav>a{text-decoration:none}.site-header nav>a[aria-current=page]{color:var(--chile)}.menu-dropdown{position:relative}.menu-dropdown summary{list-style:none;cursor:pointer;padding:.5rem 0}.menu-dropdown summary::-webkit-details-marker{display:none}.menu-dropdown .active{color:var(--chile)}.dropdown-panel{position:absolute;top:100%;left:-1rem;min-width:230px;background:var(--card);border:1px solid var(--line);padding:.6rem;border-radius:10px;box-shadow:var(--shadow)}.dropdown-panel a{display:block;padding:.6rem .8rem;text-decoration:none;border-radius:5px}.dropdown-panel a:hover{background:var(--gold)}.button{display:inline-flex;justify-content:center;align-items:center;gap:1rem;border:1px solid var(--chile);background:var(--chile);color:var(--paper);text-decoration:none;border-radius:6px;padding:.9rem 1.4rem;font-weight:600;font-size:.95rem;transition:background .2s,transform .2s}.button:hover{background:#8c281d;transform:translateY(-2px)}.button.secondary{background:transparent;border-color:var(--ink);color:var(--ink)}.button.gold{background:var(--gold);border-color:var(--gold);color:var(--bg)}.button.gold:hover{background:#f5c033}.page{width:min(1200px,calc(100% - 3rem));margin:auto;padding:4.5rem 0}.eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--chile);margin-bottom:1rem}.lede{font-size:1.15rem;max-width:42rem;color:var(--muted)}.actions{display:flex;gap:.8rem;flex-wrap:wrap;margin:1.8rem 0}.section-top{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.section-top h2{margin-bottom:0}.text-link{font-weight:600;text-underline-offset:5px;color:var(--chile)}.call-band{background:var(--bg);color:var(--paper)}.call-band .page{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding-top:3rem;padding-bottom:3rem}.call-band h2{margin-bottom:.8rem}.call-band p{color:#f1ecd2}.call-band .eyebrow{color:var(--gold)}.site-footer{background:#102b20;color:var(--paper);padding:3.5rem max(5vw,1.5rem) 1.5rem}.footer-inner{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:3rem;max-width:1200px;margin:auto}.footer-inner p{font-size:.88rem;color:#cbd0be;margin-top:1rem}.footer-inner .eyebrow{color:var(--gold);margin-top:0}.footer-inner>div>a:not(.brand){display:block;margin:.5rem 0;text-decoration:none}.footer-inner .footer-phone{font-size:1.4rem;font-weight:600}.footer-bottom{max-width:1200px;margin:2.5rem auto 0;border-top:1px solid #ffffff25;padding-top:1rem;font-size:.75rem;color:#cbd0be;display:flex;justify-content:space-between}.mobile-call{display:none}
@media(max-width:800px){.site-header{flex-wrap:wrap;padding:.8rem 1rem}.brand-logo{width:108px;height:72px}.brand span{font-size:1.6rem}.site-header nav{gap:1.2rem;font-size:.85rem;width:100%;justify-content:space-between;flex-wrap:wrap}.nav-order{padding:.55rem .75rem;font-size:.8rem}.top-strip{font-size:.6rem;letter-spacing:.05em}.page{padding:3rem 0;width:calc(100% - 2rem)}.section-top{align-items:flex-start;flex-direction:column;gap:1rem}.call-band .page{align-items:flex-start;flex-direction:column}.footer-inner{grid-template-columns:1fr;gap:1.5rem}.footer-bottom{flex-direction:column;gap:.5rem}body{padding-bottom:62px}.mobile-call{position:fixed;bottom:0;left:0;right:0;z-index:30;background:var(--chile);color:var(--paper);display:flex;justify-content:space-between;align-items:center;padding:1rem;text-decoration:none}.dropdown-panel{left:-4rem}.site-header{position:relative}html{scroll-padding-top:20px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
</style>
<script>
const menu = document.querySelector<HTMLDetailsElement>('.menu-dropdown');
document.addEventListener('click',event=>{if(menu && event.target instanceof Node && !menu.contains(event.target))menu.open=false;});
document.addEventListener('keydown',event=>{if(event.key==='Escape' && menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
</script>
