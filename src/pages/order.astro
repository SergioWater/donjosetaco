---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { PHONE, PHONE_LABEL } from '../data/menu';
---
<Layout title="Order — Call (669) 301-6355 for Pickup" description="Order Don Jose Tacos by phone at +1 (669) 301-6355. Choose shrimp tacos, burritos, quesadillas, or mulitas and call to confirm prices and pickup time.">
<div class="page order-page"><div class="order-copy"><p class="eyebrow">FROM OUR TRUCK. TO YOUR HANDS.</p><h1>Your next taco<br/>is one <em>call away.</em></h1><p class="lede">Ready for shrimp tacos? Order directly with Don Jose Tacos by phone.</p><a class="phone-card" href={'tel:'+PHONE}><span>CALL TO PLACE YOUR ORDER</span><strong>+1 {PHONE_LABEL}</strong><small>Tap to call ↗</small></a><p class="order-note">We’ll confirm current prices, availability, your total, and pickup time when you call.</p><a class="text-link" href="/menu">Browse the full menu first ↗</a></div><div class="order-image"><img src="/images/shrimp-taco-ai.webp" alt="Signature shrimp taco" width="1536" height="1024"/></div><section class="order-steps" aria-label="How to order"><article><span>01</span><h3>Pick your favorites</h3><p>Explore our <a href="/menu">menu</a>: camarón tacos, burritos, quesadillas, mulitas, and drinks.</p></article><article><span>02</span><h3>Give us a call</h3><p>Call <a href={'tel:'+PHONE}>{PHONE_LABEL}</a>. Tell us your items and quantities; we’ll confirm your order.</p></article><article><span>03</span><h3>Meet us at the truck</h3><p>Confirm your pickup time over the phone, then use our <a href="/locations">Locations page</a> for directions.</p></article></section></div>
</Layout>
<style>
.order-page{display:grid;grid-template-columns:1.15fr 1fr;gap:3rem;align-items:center}.order-copy h1{font-size:clamp(2.7rem,5vw,4.7rem)}.order-copy em{font-style:italic;color:var(--chile)}.phone-card{display:flex;flex-direction:column;gap:.5rem;background:var(--bg);padding:1.7rem 2rem;border-radius:8px;margin:2rem 0 1rem;color:var(--paper);text-decoration:none;box-shadow:var(--shadow)}.phone-card span{font-size:.7rem;letter-spacing:.13em;color:var(--gold);font-weight:700}.phone-card strong{font-size:clamp(1.5rem,3vw,2.4rem);letter-spacing:-.03em}.phone-card small{font-size:.85rem}.order-note{font-size:.85rem;color:var(--muted)}.order-image img{height:470px;width:100%;object-fit:cover;border-radius:10px}.order-image p{font-size:.7rem;color:var(--muted);margin-top:.6rem}.order-steps{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);padding-top:2.5rem;gap:2rem}.order-steps span{display:inline-grid;place-items:center;border:1px solid var(--line);background:var(--gold);color:var(--ink);width:40px;height:40px;border-radius:50%;font-size:.8rem;font-weight:700;margin-bottom:1.2rem}.order-steps p{font-size:.95rem;color:var(--muted)}
@media(max-width:750px){.order-page{grid-template-columns:1fr;gap:2rem}.order-image img{height:320px}.order-steps{grid-template-columns:1fr;gap:1rem}.phone-card{padding:1.5rem}}
</style>
