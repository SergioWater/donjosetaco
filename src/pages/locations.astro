---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { MAPS_URL, DIRECTIONS_URL, MAP_EMBED_URL, STREET_ADDRESS, BUSINESS_HOURS, PHONE, PHONE_LABEL } from '../data/menu';
---
<Layout title="Locations — Find Our San Jose Taco Truck" description="Visit Don Jose Tacos at 3365 Keaton Loop, San Jose. Sunday 9 AM–7 PM, Monday 9 AM–4 PM, Tuesday–Saturday 9 AM–9 PM. Call (669) 301-6355 for pickup orders.">
<div class="page"><p class="eyebrow">SAN JOSE, CALIFORNIA</p><h1>Follow the flavor.</h1><p class="lede">Find the Don Jose Tacos truck. Bring your appetite for tacos de camarón.</p><section class="location-card"><div class="location-info"><span class="location-number">01 / SAN JOSE</span><h2>Don Jose Tacos</h2><address>{STREET_ADDRESS}<br/>San Jose, California</address><p class="location-note">Find our truck at 3365 Keaton Loop. Stop by for tacos de camarón or call ahead to order for pickup.</p><div class="actions"><a class="button" href={DIRECTIONS_URL} target="_blank" rel="noopener">Get directions ↗</a><a class="button secondary" href={MAPS_URL} target="_blank" rel="noopener">View on Google Maps</a></div><div class="location-details"><h3>Opening hours</h3><dl class="hours">{BUSINESS_HOURS.map(hours=><div><dt>{hours.label}</dt><dd>{hours.display}</dd></div>)}</dl><p>Call for current prices and pickup availability.</p><a class="text-link" href={'tel:'+PHONE}>{PHONE_LABEL} ↗</a></div></div><iframe title="Map showing the Don Jose Tacos location in San Jose" src={MAP_EMBED_URL} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></section></div>
<section class="call-band"><div class="page"><div><p class="eyebrow">PICKUP MADE SIMPLE</p><h2>Order before you arrive.</h2><p>Choose your favorites, call the truck, and confirm a pickup time.</p></div><a class="button gold" href="/order">Place a phone order ↗</a></div></section>
</Layout>
<style>
.location-card{display:grid;grid-template-columns:1fr 1fr;margin-top:3rem;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--card)}.location-info{padding:2.5rem}.location-number{display:block;font-size:.7rem;letter-spacing:.15em;color:var(--chile);font-weight:700;margin-bottom:2rem}.location-info h2{font-size:2.5rem}.location-note{color:var(--muted);font-size:.95rem;max-width:32rem}address{font-style:normal;margin-bottom:1rem}.hours{margin:1rem 0 1.5rem}.hours>div{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 0;border-bottom:1px solid var(--line);font-size:.9rem}.hours dt{font-weight:600}.hours dd{margin:0;white-space:nowrap}.location-details{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--line)}.location-details h3{font-size:1.3rem}.location-details p{font-size:.9rem;color:var(--muted)}iframe{width:100%;height:100%;min-height:540px;border:0;background:#e9e6d8}
@media(max-width:700px){.location-card{grid-template-columns:1fr}.location-info{padding:1.5rem}iframe{min-height:350px;height:350px}}
</style>
