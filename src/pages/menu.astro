---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { UPLOADED_PHOTOS } from '../lib/media';
const sectionPhotos: Record<string, typeof UPLOADED_PHOTOS> = {tacos: UPLOADED_PHOTOS.slice(0,2), burritos: [UPLOADED_PHOTOS[4]], drinks: [UPLOADED_PHOTOS[3]]};
import { MENU_SECTIONS, MEAT_OPTIONS, SHRIMP_FILLING, VEGETARIAN_FILLING, PHONE, PHONE_LABEL } from '../data/menu';
---
<Layout title="Menu — Shrimp Tacos, Burritos & Quesadillas" description="Explore Don Jose Tacos: tacos de camarón, tacos, burritos, quesadillas, mulitas, weekend specials, and drinks. Call (669) 301-6355 for prices and pickup orders.">
<div class="page"><header class="menu-intro"><p class="eyebrow">DON JOSE TACOS · EL MENÚ</p><h1>Find your<br/><em>next favorite.</em></h1><p class="lede">Start with our signature shrimp tacos. Explore every option below, then call us to make it your order.</p><div class="actions"><a class="button" href="/order">Order by phone ↗</a><a class="text-link artwork-link" href="#menu-artwork">View the menu artwork ↓</a></div><p class="price-note">Call {PHONE_LABEL} for current prices, fillings, and availability.</p></header>
<nav class="menu-tabs" aria-label="Menu sections"><a href="#fillings">Meats & fillings</a>{MENU_SECTIONS.map(section=><a href={'#'+section.id}>{section.title}</a>)}</nav>
<section id="fillings" class="filling-guide" aria-labelledby="fillings-heading"><div class="section-top"><div><p class="eyebrow">ELIGE TU FAVORITO · CHOOSE YOUR FAVORITE</p><h2 id="fillings-heading">Meats & fillings</h2></div><p class="filling-intro">Choose your filling when you call to order. Each dish below lists its options.</p></div><ul class="meat-options">{MEAT_OPTIONS.map(filling=><li><h3>{filling.name}</h3><p>{filling.translation}</p></li>)}</ul><div class="other-fillings"><div><span class="filling-type">SEAFOOD</span><strong>{SHRIMP_FILLING.name}</strong><span>{SHRIMP_FILLING.translation} · For tacos de camarón & shrimp quesadillas</span></div><div><span class="filling-type">VEGETARIAN</span><strong>{VEGETARIAN_FILLING.name}</strong><span>{VEGETARIAN_FILLING.translation} option</span></div></div><p class="availability-note">Call {PHONE_LABEL} for today’s filling availability.</p></section>
{MENU_SECTIONS.map(section=><section class="menu-section" id={section.id}><div class="section-heading"><p class="eyebrow">{section.subtitle}</p><h2>{section.title}</h2></div><div class="menu-items">{section.items.map(item=><article class:list={['menu-item',{'signature': 'featured' in item && item.featured}]}>{'featured' in item && item.featured && <span class="signature-label">HOUSE FAVORITE</span>}<h3>{item.name}</h3><p class="translation">{item.translation}</p><p>{item.description}</p>{item.fillings && <div class="dish-fillings"><p class="fillings-label">{item.fillings.length===1 ? "FILLING" : "CHOOSE YOUR FILLING"}</p><ul>{item.fillings.map(filling=><li><strong>{filling.name}</strong><span>{filling.translation}</span></li>)}</ul></div>}</article>)}</div>{sectionPhotos[section.id] && <div class="menu-photos">{sectionPhotos[section.id].map(photo=><a href={photo.src} target="_blank" rel="noopener" aria-label={"View photo: " + photo.alt}><img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" /></a>)}</div>}</section>)}
<section id="menu-artwork" class="artwork-section"><div><p class="eyebrow">A FRESH LOOK AT EL MENÚ</p><h2>The menu,<br/>all together.</h2><p class="lede">A clean redesign of our truck menu. You’ll find the complete food options above, including specials.</p><p class="art-note">Call for current prices and availability.</p><a class="text-link" href="/images/menu-clean-ai.webp" target="_blank" rel="noopener">Open full-size menu ↗</a></div><a href="/images/menu-clean-ai.webp" target="_blank" rel="noopener" aria-label="Open full-size Don Jose Tacos menu artwork"><img src="/images/menu-clean-ai.webp" alt="Don Jose Tacos redesigned menu listing tacos, burritos, quesadillas, mulitas, drinks, and phone number (669) 301-6355" width="1024" height="1536" loading="lazy" /></a></section>
</div>
<section class="call-band"><div class="page"><div><p class="eyebrow">YOUR ORDER STARTS HERE</p><h2>Choose it. Call it. Pick it up.</h2><p>We’ll confirm your order, total, and pickup time over the phone.</p></div><a class="button gold" href={'tel:'+PHONE}>Call {PHONE_LABEL} ↗</a></div></section>
</Layout>
<style>
.menu-photos{grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1rem}.menu-photos a{display:block;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--card)}.menu-photos img{width:100%;height:280px;object-fit:contain}

.filling-guide{padding:2rem;background:#f1ecd8;border:1px solid var(--line);border-radius:10px;margin-bottom:3rem}.filling-guide h2{font-size:clamp(2rem,4vw,3rem)}.filling-intro{max-width:25rem;font-size:.95rem;color:var(--muted);margin:0}.meat-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;margin:0;padding:0}.meat-options li{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:1.2rem}.meat-options h3{margin-bottom:.4rem}.meat-options p{font-size:.9rem;color:var(--muted);margin:0}.other-fillings{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.other-fillings>div{display:flex;flex-direction:column;gap:.3rem;border:1px solid var(--line);border-radius:6px;background:var(--paper);padding:1.2rem}.other-fillings strong{font-size:1.1rem}.other-fillings span{font-size:.85rem;color:var(--muted)}.other-fillings .filling-type{font-size:.62rem;letter-spacing:.13em;color:var(--chile);font-weight:700}.availability-note{font-size:.82rem;color:var(--muted);margin:1.2rem 0 0}.dish-fillings{margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--line)}.fillings-label{font-size:.62rem;letter-spacing:.11em;font-weight:700;color:var(--chile);margin-bottom:.6rem}.dish-fillings ul{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin:0}.dish-fillings li{display:flex;flex-direction:column;padding:.45rem .65rem;border:1px solid var(--line);border-radius:5px;background:var(--paper);font-size:.8rem}.dish-fillings li span{font-size:.7rem;color:var(--muted)}

.menu-intro{max-width:800px}.menu-intro em{font-style:italic;color:var(--chile)}.artwork-link{align-self:center}.price-note{font-size:.85rem;color:var(--muted)}.menu-tabs{display:flex;flex-wrap:wrap;gap:.6rem;margin:2rem 0 3rem}.menu-tabs a{padding:.65rem 1rem;border:1px solid var(--line);border-radius:5px;text-decoration:none;background:var(--card);font-size:.85rem;font-weight:600}.menu-tabs a:hover{background:var(--gold)}.menu-section{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding:2.5rem 0;border-top:1px solid var(--line)}.section-heading .eyebrow{letter-spacing:.09em}.menu-items{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.menu-item{border:1px solid var(--line);border-radius:8px;padding:1.5rem;background:var(--card)}.menu-item h3{margin:.2rem 0 .45rem}.menu-item>p{font-size:.9rem;color:var(--muted);margin-bottom:0}.menu-item .translation{font-weight:600;font-size:.8rem;color:var(--chile);margin-bottom:.8rem}.signature{background:#fff0bc;border-color:#dfbd5d}.signature-label{display:inline-block;font-size:.6rem;letter-spacing:.12em;font-weight:700;color:var(--chile);margin-bottom:.65rem}.artwork-section{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;margin-top:3rem;padding-top:3rem;border-top:1px solid var(--line)}.artwork-section img{height:auto;width:100%;max-width:460px;border-radius:8px;box-shadow:var(--shadow)}.art-note{font-size:.78rem;color:var(--muted);margin:1rem 0}
@media(max-width:700px){.filling-guide{padding:1.3rem}.meat-options{grid-template-columns:repeat(2,minmax(0,1fr))}.other-fillings{grid-template-columns:1fr}.menu-section{grid-template-columns:1fr;gap:1rem}.menu-items{grid-template-columns:1fr}.artwork-section{grid-template-columns:1fr;gap:2rem}}
</style>
