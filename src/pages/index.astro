---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { PHONE, PHONE_LABEL } from '../data/menu';
---
<Layout title="Best Shrimp Tacos in San Jose — Tacos de Camarón">
<section class="hero"><div class="hero-copy"><p class="eyebrow">SAN JOSE’S SHRIMP TACO SPOT</p><h1>Tacos de<br/><em>camarón.</em><br/>Big flavor.</h1><p class="hero-lede">Golden tortilla. Juicy shrimp. That first bite.<br/>Meet the house favorite at Don Jose Tacos.</p><div class="actions"><a class="button" href="/menu">Explore the menu <span aria-hidden="true">↗</span></a><a class="button secondary" href="/order">Call to order</a></div><p class="hero-note">Made for your cravings. Right here in San Jose.</p></div><div class="hero-photo"><img src="/images/shrimp-taco-ai.webp" alt="Taco de camarón with shrimp, melted cheese, tomato, cilantro, and crema" width="1536" height="1024" fetchpriority="high" /><span class="food-stamp">THE HOUSE<br/><strong>FAVORITE</strong><br/>TACOS DE CAMARÓN</span></div></section>
<div class="flavor-strip" aria-hidden="true"><span>CAMARÓN</span><span>✦</span><span>ASADA</span><span>✦</span><span>PASTOR</span><span>✦</span><span>QUESADILLAS</span><span>✦</span><span>MUCHO SABOR</span></div>
<section class="page favorites"><div class="section-top"><div><p class="eyebrow">FROM THE TRUCK TO YOUR TABLE</p><h2>Come for the shrimp.<br/>Stay for the menu.</h2></div><a class="text-link" href="/menu">See all menu options ↗</a></div><div class="favorite-grid"><a class="favorite-card" href="/menu#tacos"><img src="/images/shrimp-taco-ai.webp" alt="Our signature shrimp taco" width="1536" height="1024" loading="lazy"/><div><p class="eyebrow">THE SIGNATURE</p><h3>Tacos de Camarón</h3><p>Your search for the best shrimp tacos in San Jose starts with this bite.</p><span class="text-link">Meet your favorite ↗</span></div></a><a class="favorite-card" href="/menu#quesadillas"><img src="/images/quesadilla-ai.webp" alt="Corn tortilla quesadilla with filling, grilled onions, and lime" width="1536" height="1024" loading="lazy"/><div><p class="eyebrow">OFF THE PLANCHA</p><h3>Quesadillas & Mulitas</h3><p>Flour or corn tortilla? Shrimp or your favorite filling? Find your next order.</p><span class="text-link">Explore the options ↗</span></div></a><div class="menu-tile"><p class="eyebrow">A LITTLE MORE SABOR</p><h3>Tacos.<br/>Burritos.<br/>Drinks.<br/>Your call.</h3><p>Browse every category, choose your favorites, and give us a ring.</p><a class="button gold" href="/menu">Full menu ↗</a></div></div></section>
<section class="visit"><div class="page visit-inner"><div><p class="eyebrow">YOUR NEIGHBORHOOD TACO STOP</p><h2>Find us.<br/>Bring your appetite.</h2></div><div><p class="lede">Head to 3365 Keaton Loop in San Jose for tacos de camarón and more. Open Sunday 9 AM–7 PM, Monday 9 AM–4 PM, and Tuesday–Saturday 9 AM–9 PM.</p><a class="text-link" href="/locations">Find the truck ↗</a></div></div></section>
<section class="call-band"><div class="page"><div><p class="eyebrow">GOOD FOOD IS ONE CALL AWAY</p><h2>Ready for your next bite?</h2><p>Call us to place your order and confirm your pickup time.</p></div><a class="button gold" href={'tel:'+PHONE}>Call {PHONE_LABEL} ↗</a></div></section>
</Layout>
<style>
.hero{display:grid;grid-template-columns:1fr 1.15fr;min-height:640px}.hero-copy{padding:5rem 2rem 4rem max(5vw,1.5rem);align-self:center}.hero h1{font-size:clamp(3rem,6vw,6.4rem);line-height:1.08;margin-bottom:1.8rem}.hero em{color:var(--chile);font-style:normal}.hero-lede{font-size:1.1rem;color:var(--muted);max-width:31rem}.hero-note{font-size:.78rem;color:var(--muted)}.hero-photo{position:relative;min-height:540px;background:var(--bg);overflow:hidden}.hero-photo img{height:100%;width:100%;object-fit:cover;object-position:54% center}.food-stamp{position:absolute;right:1.5rem;top:2rem;border-radius:50%;background:var(--gold);color:var(--ink);padding:1.5rem 1rem;text-align:center;transform:rotate(12deg);font-size:.65rem;font-weight:700;line-height:1.7;border:2px solid var(--ink);outline:6px solid var(--gold)}.food-stamp strong{font-family:Arial,Helvetica,sans-serif;font-size:1.2rem}.flavor-strip{background:var(--gold);padding:1rem;display:flex;justify-content:space-around;gap:1rem;font-size:.78rem;font-weight:700;letter-spacing:.1em;overflow:hidden}.favorite-grid{display:grid;grid-template-columns:1fr 1fr .8fr;gap:1.5rem}.favorite-card{display:flex;flex-direction:column;text-decoration:none;border:1px solid var(--line);background:var(--card);border-radius:8px;overflow:hidden;box-shadow:var(--shadow)}.favorite-card img{aspect-ratio:4/3;object-fit:cover;width:100%;height:auto}.favorite-card>div{padding:1.5rem}.favorite-card p:not(.eyebrow){font-size:.93rem;color:var(--muted)}.favorite-card .eyebrow{font-size:.65rem}.favorite-card h3{font-size:1.5rem}.menu-tile{background:var(--bg);padding:2rem;color:var(--paper);border-radius:8px;display:flex;flex-direction:column;justify-content:center}.menu-tile .eyebrow{color:var(--gold)}.menu-tile h3{font-size:2.6rem}.menu-tile p{font-size:.9rem;color:#d6dccb}.visit{border-block:1px solid var(--line);background:#f1ecd8}.visit-inner{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:3rem}.visit .text-link{display:inline-block;margin-top:1rem}
@media(max-width:950px){.hero{grid-template-columns:1fr 1fr;min-height:500px}.hero-copy{padding:3rem 1.5rem}.hero-photo{min-height:500px}.favorite-grid{grid-template-columns:1fr 1fr}.menu-tile{grid-column:1/-1}.menu-tile h3{font-size:2rem}.visit-inner{gap:2rem}}@media(max-width:600px){.hero{grid-template-columns:1fr}.hero-copy{padding:2.5rem 1rem}.hero h1{font-size:3.8rem}.hero-photo{min-height:0;height:350px}.food-stamp{top:1rem;right:1rem}.flavor-strip{flex-wrap:wrap;font-size:.65rem}.favorite-grid,.visit-inner{grid-template-columns:1fr}.menu-tile{grid-column:auto}}
</style>
